{
  "$schema": "https://tree-sitter.github.io/tree-sitter/assets/schemas/config.schema.json",
  "grammars": [
    {
      "name": "cpp",
      "camelcase": "Cpp",
      "title": "C++ Tree Sitter",
      "scope": "source.cpp",
      "file-types": [
        "cpp"
      ],
      "injection-regex": "^cpp$",
      "class-name": "TreeSitterCpp"
    }
  ],
   "parser-directories": [
    "C:\\Users\\Cameron\\Downloads\\xandriaai\\tree-sitter-c\\test.cpp"
  ],
  "metadata": {
    "version": "0.1.0",
    "license": "MIT",
    "description": "A tree sitter that supports c++",
    "authors": [
      {
        "name": "Cameron Parker"
      }
    ],
    "links": {
      "repository": "https://github.com/alexandriaai/xandriaai.git"
    }
  },
  "bindings": {
    "c": true,
    "go": true,
    "node": true,
    "python": true,
    "rust": true,
    "swift": true,
    "zig": false
  }
}