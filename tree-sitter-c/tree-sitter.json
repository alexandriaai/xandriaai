{
  "$schema": "https://tree-sitter.github.io/tree-sitter/assets/schemas/config.schema.json",
  "grammars": [
    {
      "name": "c",
      "camelcase": "C",
      "title": "C tree sitter",
      "scope": "source.c",
      "file-types": [
        "c"
      ],
      "injection-regex": "^c$",
      "class-name": "TreeSitterC"
    }
  ],
  "parser-directories": [
    "C:\\Users\\Cameron\\Downloads\\xandriaai\\tree-sitter-c\\test.c"
  ],
  "metadata": {
    "version": "0.1.0",
    "license": "MIT",
    "description": "A tree sitter that supports C",
    "authors": [
      {
        "name": "Cameron Parker"
      }
    ],
    "links": {
      "repository": "https://github.com/alexandriaai/xandriaai.git"
    }
  },
  "bindings": {
    "c": true,
    "go": true,
    "node": true,
    "python": true,
    "rust": true,
    "swift": true,
    "zig": false
  }
