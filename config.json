{
  "projectName": "XandriaAI",
  "version": "1.0.0",

  "backend": {
    "uri": "https://xandriaai.onrender.com",   
    "url": "https://xandriaai.onrender.com",
    "port": 443,
    "reload": false
  },

  "frontend": {
    "theme": "dark",
    "languageSupport": ["python", "typescript"],
    "showLogs": true
  },

  "analysis": {
    "useSonarCloud": true,
    "useBandit": true,
    "sonarProjectKey": "xandriaai-project-key",
    "sonarOrganization": "xandria-org",
    "qualityGate": "strict"
  },

  "subsystems": {
    "active": ["snippetGenerator", "docLookup", "feedback"],

    "snippetGenerator": {
      "model": "gpt-5",
      "maxTokens": 500
    },

    "docLookup": {
      "indexPath": "./data/docs_index.json"
    },

    "feedback": {
      "enabled": true
    }
  },

  "logging": {
    "level": "debug",
    "file": "./logs/xandria.log"
  }
}
